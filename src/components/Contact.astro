---
import type { Translations } from "../i18n/es";
interface Props {
    t: Translations;
}
const { t } = Astro.props;
const c = t.contact;
---

<section id="contact" class="relative z-10 bg-bg-2 py-16 px-6 md:py-24 md:px-12">
    <div class="flex items-center gap-4 mb-14 fade-up">
        <span class="font-mono text-xs text-muted tracking-widest"
            >{c.sectionNum}</span
        >
        <h2 class="text-3xl font-extrabold tracking-tight">{c.sectionTitle}</h2>
        <div class="flex-1 h-px bg-border"></div>
    </div>

    <div class="grid md:grid-cols-2 gap-16 md:items-stretch items-start">
        <div class="fade-up">
            <h2
                class="text-4xl font-extrabold leading-tight tracking-tight mb-4"
            >
                {c.heading1}<br />{c.heading2}
                <em class="not-italic text-accent">{c.headingEm}</em>
            </h2>
            <p class="text-sub leading-[1.75] mb-8">{c.body}</p>

            <div class="flex flex-col gap-3">
                <a
                    href="mailto:contacto@hugocano.dev"
                    class="flex items-center gap-4 font-mono text-sm text-sub bg-bg-3 border border-border rounded px-5 py-4 hover:border-accent hover:text-accent transition-all"
                >
                    <span class="text-accent w-5 text-center">@</span>
                    contacto@hugocano.dev
                </a>
                <a
                    href="tel:+526221578267"
                    class="flex items-center gap-4 font-mono text-sm text-sub bg-bg-3 border border-border rounded px-5 py-4 hover:border-accent hover:text-accent transition-all"
                >
                    <span class="text-accent w-5 text-center">#</span>
                    +52 (622) 157-8267
                </a>
                <a
                    href="https://wa.me/526221125886"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-4 font-mono text-sm text-sub bg-bg-3 border border-border rounded px-5 py-4 hover:border-accent hover:text-accent transition-all"
                >
                    <span class="text-accent w-5 text-center">wa</span>
                    +52 (622) 112-5886 (WhatsApp)
                </a>
                <a
                    href="https://linkedin.com/in/hugo-francisco-cano-beyliss-a10025213/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-4 font-mono text-sm text-sub bg-bg-3 border border-border rounded px-5 py-4 hover:border-accent hover:text-accent transition-all"
                >
                    <span class="text-accent w-5 text-center">in</span>
                    linkedin.com/in/hugo-francisco-cano-beyliss
                </a>
            </div>
        </div>

        <div class="bg-bg-3 border border-border rounded-md p-8 fade-up h-full flex flex-col justify-center">
            <div class="flex items-center gap-3 mb-8">
                <div class="w-3 h-3 rounded-full bg-accent avail-dot"></div>
                <span class="font-mono text-sm text-accent">{c.available}</span>
            </div>
            <div class="text-sub text-base leading-[1.8] space-y-6">
                <p set:html={c.location} />
                <p set:html={c.openTo} />
                <ul class="space-y-2.5 font-mono text-sm text-sub pl-2">
                    {c.services.map((s) => <li>→ {s}</li>)}
                </ul>
                <p set:html={c.languages} />
            </div>
        </div>
    </div>
</section>
