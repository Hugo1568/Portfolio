---
import { languages, getAlternatePath, type Lang } from "../i18n/utils";
import type { Translations } from "../i18n/es";

interface Props {
    t: Translations;
    lang: Lang;
    currentPath: string;
}

const { t, lang, currentPath } = Astro.props;
const altLang = lang === "es" ? "en" : "es";
const altPath = getAlternatePath(currentPath);
---

<nav
    class="fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-6 py-4 md:px-12 md:py-5 bg-bg/85 backdrop-blur-md border-b border-border"
>
    <div class="font-mono text-sm text-accent tracking-widest">
        HC<span class="text-sub">.dev</span>
    </div>

    <ul class="hidden md:flex gap-10 list-none">
        {
            (
                [
                    ["#about", t.nav.about],
                    ["#experience", t.nav.experience],
                    ["#projects", t.nav.projects],
                    ["#certs", t.nav.certs],
                    ["#contact", t.nav.contact],
                ] as [string, string][]
            ).map(([href, label]) => (
                <li>
                    <a
                        href={href}
                        class="font-mono text-xs text-sub tracking-widest hover:text-accent transition-colors"
                    >
                        {label}
                    </a>
                </li>
            ))
        }
    </ul>

    <div class="flex items-center gap-3">
        <!-- Language switcher -->
        <a
            href={altPath}
            class="font-mono text-xs text-sub border border-border px-3 py-1.5 rounded hover:border-accent hover:text-accent transition-all flex items-center gap-1.5"
            title={`Switch to ${languages[altLang].label}`}
        >
            <span>{languages[altLang].flag}</span>
            <span>{languages[altLang].label}</span>
        </a>
        <a
            href="https://wa.me/526221125886"
            target="_blank"
            rel="noopener noreferrer"
            class="font-mono text-xs text-accent border border-accent px-4 py-2 rounded hover:bg-accent hover:text-bg transition-all"
        >
            {t.nav.hire}
        </a>
    </div>
</nav>
