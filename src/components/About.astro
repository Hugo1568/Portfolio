---
import type { Translations } from "../i18n/es";
interface Props {
    t: Translations;
}
const { t } = Astro.props;
const a = t.about;
---

<section id="about" class="relative z-10 bg-bg-2 py-16 px-6 md:py-24 md:px-12">
    <div class="flex items-center gap-4 mb-14 fade-up">
        <span class="font-mono text-xs text-muted tracking-widest"
            >{a.sectionNum}</span
        >
        <h2 class="text-3xl font-extrabold tracking-tight">{a.sectionTitle}</h2>
        <div class="flex-1 h-px bg-border"></div>
    </div>

    <div class="grid md:grid-cols-2 gap-16 items-start">
        <div class="space-y-4 text-sub leading-[1.8] fade-up">
            <p set:html={a.p1} />
            <p set:html={a.p2} />
            <p set:html={a.p3} />
            <p set:html={a.p4} />
        </div>

        <div class="flex flex-col gap-6 fade-up">
            {
                a.skills.map(({ cat, tags }) => (
                    <div>
                        <p class="font-mono text-xs text-accent tracking-widest uppercase mb-2">
                            {cat}
                        </p>
                        <div class="flex flex-wrap gap-2">
                            {tags.map((tag) => (
                                <span class="font-mono text-xs bg-bg-3 border border-border text-sub px-3 py-1 rounded-sm hover:border-accent hover:text-accent transition-colors cursor-default">
                                    {tag}
                                </span>
                            ))}
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
