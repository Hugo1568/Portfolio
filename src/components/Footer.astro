---
import type { Translations } from "../i18n/es";
interface Props {
    t: Translations;
}
const { t } = Astro.props;
---

<footer
    class="relative z-10 bg-bg border-t border-border px-6 md:px-12 py-8 flex flex-col sm:flex-row justify-between items-center gap-4"
>
    <p class="font-mono text-xs text-muted">{t.footer.copy}</p>
    <p class="font-mono text-xs text-muted">{t.footer.built}</p>
</footer>
