---
import "../styles/global.css";
import type { Lang } from "../i18n/utils";

interface Props {
    title?: string;
    description?: string;
    lang?: Lang;
}

const {
    title = "Hugo Cano — Full Stack Developer & IT Specialist",
    description = "Desarrollador Full Stack e IT Specialist en Sonora, México.",
    lang = "es",
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <title>{title}</title>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    </head>
    <body class="noise-bg grid-bg">
        <slot />
        <script>
            const observer = new IntersectionObserver(
                (entries) =>
                    entries.forEach((e) => {
                        if (e.isIntersecting) e.target.classList.add("visible");
                    }),
                { threshold: 0.12 },
            );
            document
                .querySelectorAll(".fade-up")
                .forEach((el) => observer.observe(el));
        </script>
    </body>
</html>
